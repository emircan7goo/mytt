# ── Veritabanı ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/telefoncum_db?schema=public"

# ── JWT ──────────────────────────────────────────────────────────────────────
# Üretim için: openssl rand -base64 64
JWT_SECRET="CHANGE_ME_STRONG_RANDOM_SECRET_MIN_32_CHARS"

# ── Uygulama ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
# Üretimde virgülle ayır: "https://telefoncum.com,https://www.telefoncum.com"

# ── Cookie ───────────────────────────────────────────────────────────────────
COOKIE_DOMAIN=""
# Üretimde: ".telefoncum.com"

# ── Dosya Yükleme ────────────────────────────────────────────────────────────
UPLOADS_DIR=""
# Üretimde mutlak yol ver: "/var/www/telefoncum/uploads"

# ── Ödeme (PayTR) ────────────────────────────────────────────────────────────
# paytr.com → Üye İş Yeri Başvurusu'ndan al
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# PayTR panelinde Callback URL: https://SITEADIN.com/payment/paytr-callback

# ── E-posta (SMTP) ───────────────────────────────────────────────────────────
# Seçenekler: Gmail (smtp.gmail.com:587), Resend, Brevo, Mailgun
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""         # Gmail: uygulama şifresi kullan (2FA açıkken)
SMTP_PASS=""
SMTP_FROM="noreply@telefoncum.com"

# ── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
