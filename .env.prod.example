# ── Zorunlu: Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://mytt:STRONG_PASSWORD@db:5432/mytt_prod?schema=public"
DB_USER=mytt
DB_PASSWORD=STRONG_PASSWORD_HERE
DB_NAME=mytt_prod

# ── Zorunlu: Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=GENERATE_WITH_openssl_rand_-base64_64

# ── Zorunlu: App URLs ─────────────────────────────────────────────────────────
NODE_ENV=production
FRONTEND_URL=https://mytt.com
NEXT_PUBLIC_API_URL=https://api.mytt.com

# ── Zorunlu: Uploads ──────────────────────────────────────────────────────────
UPLOADS_DIR=/app/uploads

# ── Ödeme Modu (Soft Launch) ──────────────────────────────────────────────────
# true  → PayTR iframe atlanır, sipariş doğrudan ESCROW'a geçer (staging/test)
# false → Gerçek PayTR akışı; aşağıdaki PAYTR_* değerleri zorunlu olur
MOCK_PAYMENT=true

# ── PayTR (MOCK_PAYMENT=false ise zorunlu) ────────────────────────────────────
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# ── E-posta (en az biri zorunlu) ──────────────────────────────────────────────
# Seçenek A: SMTP (Gmail App Password önerilir)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=destek@mytt.com
SMTP_PASS=APP_PASSWORD_HERE
SMTP_FROM="Mytt <destek@mytt.com>"

# Seçenek B: Resend (SMTP_* yerine)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Opsiyonel: Redis ──────────────────────────────────────────────────────────
# Mevcut hâliyle sadece hazır bekliyor; throttler henüz Redis'e bağlı değil.
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
